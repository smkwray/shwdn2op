#!/usr/bin/env python3
# Private exec registry: hashes/identity only, no argv/model text or environment dump.
from pathlib import Path
import os,json,subprocess,hashlib,sys,re
os.umask(0o077)
name=Path(sys.argv[0]).name
binary={'ssh':'/usr/bin/ssh'}[name]
game=os.environ['SHWDN2OP_GAME_RUN_ID'];cohort=os.environ['SHWDN2OP_COHORT_ID'];registry=Path(os.environ['SHWDN2OP_COHORT_REGISTRY'])
assert registry.is_absolute() and registry.parent.is_dir()
assert all(re.fullmatch(r'[A-Za-z0-9_-]{8,120}',value)for value in [game,cohort])
row=subprocess.run(['/bin/ps','-p',str(os.getpid()),'-o','pid=,ppid=,pgid=,lstart='],capture_output=True,text=True,check=True,timeout=3).stdout.split()
assert len(row)==8 and int(row[0])==os.getpid() and int(row[2])==os.getpgrp()
event={'pid':int(row[0]),'ppid':int(row[1]),'pgid':int(row[2]),'start':row[3:],
       'gameID':game,'cohortID':cohort,'kind':name,
       'argvSHA256':hashlib.sha256(json.dumps(sys.argv[1:],ensure_ascii=False).encode()).hexdigest()}
data=(json.dumps(event)+'\n').encode();fd=os.open(registry,os.O_WRONLY|os.O_APPEND|os.O_CREAT|os.O_NOFOLLOW,0o600)
try:assert os.write(fd,data)==len(data)
finally:os.close(fd)
os.execv(binary,[binary,*sys.argv[1:]])

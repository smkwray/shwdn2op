# Test scratch dirs a crashed or running liveMetamon test leaves behind
apps/companion/src/test/.live-metamon-*/

# Device-specific config (hosts, absolute paths, per-device modes): synced, never tracked.
config/local/
# Legacy device-named paths kept only while running jobs still read them.
config/metamon-live-*-mlx.json
config/uu-eval-runtime-*.json
config/uu-league-iter2-*.yaml

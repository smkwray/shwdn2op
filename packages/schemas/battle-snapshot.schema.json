{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BattleSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "capturedAt",
    "roomId",
    "title",
    "format",
    "turn",
    "phase",
    "yourSide",
    "opponentSide",
    "field",
    "legalActions",
    "recentLog",
    "notes"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "capturedAt": {
      "type": "string"
    },
    "roomId": {
      "type": "string"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "format": {
      "type": "string"
    },
    "turn": {
      "type": "integer",
      "minimum": 0
    },
    "phase": {
      "type": "string",
      "enum": [
        "preview",
        "turn",
        "finished",
        "unknown"
      ]
    },
    "pendingAttacks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "moveId": {
            "type": "string",
            "minLength": 1
          },
          "moveName": {
            "type": "string",
            "minLength": 1
          },
          "sourceSide": {
            "enum": [
              "p1",
              "p2"
            ]
          },
          "sourceInstanceId": {
            "type": "string"
          },
          "sourceAppearanceId": {
            "type": "string"
          },
          "targetSide": {
            "enum": [
              "p1",
              "p2"
            ]
          },
          "targetPosition": {
            "const": "a"
          },
          "castTurn": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "dueTurn": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "phase": {
            "const": "end_of_turn"
          },
          "status": {
            "enum": [
              "scheduled",
              "timing_unknown"
            ]
          },
          "factIds": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "moveId",
          "moveName",
          "sourceSide",
          "targetSide",
          "targetPosition",
          "castTurn",
          "dueTurn",
          "phase",
          "status",
          "factIds"
        ]
      }
    },
    "turnCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "turn", "turnFactId", "requestFactId", "fromSequence", "throughSequence"],
      "properties": {
        "source": { "const": "owned_offline_simulator" },
        "turn": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "turnFactId": { "type": "string", "minLength": 1 },
        "requestFactId": { "type": "string", "minLength": 1 },
        "fromSequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "throughSequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "yourSide": {
      "$ref": "#/$defs/sideSnapshot"
    },
    "opponentSide": {
      "$ref": "#/$defs/sideSnapshot"
    },
    "field": {
      "$ref": "#/$defs/fieldSnapshot"
    },
    "legalActions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/legalAction"
      },
      "maxItems": 720
    },
    "recentLog": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 25
    },
    "entryObservations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ident",
          "species",
          "side",
          "turn",
          "hazards",
          "types",
          "damageObserved",
          "complete",
          "observationIds"
        ],
        "properties": {
          "ident": {
            "type": "string"
          },
          "species": {
            "type": "string"
          },
          "side": {
            "type": "string"
          },
          "turn": {
            "type": "integer",
            "minimum": 0
          },
          "hazards": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "damageObserved": {
            "type": "boolean"
          },
          "complete": {
            "type": "boolean"
          },
          "observationIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "instanceId": {
            "type": "string"
          },
          "appearanceId": {
            "type": "string"
          },
          "factIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "identityStatus": {
            "enum": [
              "resolved",
              "provisional",
              "ambiguous"
            ]
          }
        }
      }
    },
    "rawRequestSummary": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 20
    },
    "canonicalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string"
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "subject": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "side": {
                    "enum": [
                      "p1",
                      "p2"
                    ]
                  },
                  "instanceId": {
                    "type": "string"
                  },
                  "appearanceId": {
                    "type": "string"
                  },
                  "candidateInstanceIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": []
              },
              "references": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "side": {
                      "enum": [
                        "p1",
                        "p2"
                      ]
                    },
                    "instanceId": {
                      "type": "string"
                    },
                    "appearanceId": {
                      "type": "string"
                    },
                    "candidateInstanceIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": []
                }
              },
              "requestSlots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "side": {
                      "enum": [
                        "p1",
                        "p2"
                      ]
                    },
                    "instanceId": {
                      "type": "string"
                    },
                    "appearanceId": {
                      "type": "string"
                    },
                    "candidateInstanceIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": []
                }
              },
              "turn": {
                "type": "integer"
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "observationId": {
                    "type": "string"
                  },
                  "sequence": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "lineIndex": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "channel": {
                    "enum": [
                      "protocol",
                      "private-request",
                      "recovery"
                    ]
                  },
                  "rqid": {
                    "type": "integer"
                  }
                },
                "required": [
                  "observationId",
                  "sequence",
                  "lineIndex",
                  "channel"
                ]
              },
              "ownerInstanceId": {
                "type": "string"
              },
              "identityStatus": {
                "enum": [
                  "resolved",
                  "provisional",
                  "ambiguous"
                ]
              },
              "supportingFactIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "overlaySpecies": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind",
              "args",
              "subject",
              "references",
              "turn",
              "source",
              "identityStatus",
              "supportingFactIds"
            ]
          }
        },
        "contributions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "instanceId": {
                "type": "string"
              },
              "species": {
                "type": "string"
              },
              "factIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "metric": {
                "enum": [
                  "battle-seen",
                  "move",
                  "item",
                  "ability",
                  "tera",
                  "damage",
                  "speed"
                ]
              },
              "value": {
                "type": "string"
              },
              "eligibility": {
                "enum": [
                  "active",
                  "quarantined",
                  "retracted"
                ]
              },
              "damage": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "turn",
                  "moveName",
                  "percent",
                  "attacker",
                  "defender",
                  "field"
                ],
                "properties": {
                  "turn": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "moveName": {
                    "type": "string"
                  },
                  "percent": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "attacker": {
                    "$ref": "#/$defs/pokemonSnapshot"
                  },
                  "defender": {
                    "$ref": "#/$defs/pokemonSnapshot"
                  },
                  "field": {
                    "$ref": "#/$defs/fieldSnapshot"
                  }
                }
              },
              "speed": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "turn",
                  "relation",
                  "pokemon",
                  "other",
                  "moveName",
                  "otherMoveName",
                  "field"
                ],
                "properties": {
                  "turn": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "relation": {
                    "enum": [
                      "first",
                      "second"
                    ]
                  },
                  "pokemon": {
                    "$ref": "#/$defs/pokemonSnapshot"
                  },
                  "other": {
                    "$ref": "#/$defs/pokemonSnapshot"
                  },
                  "moveName": {
                    "type": "string"
                  },
                  "otherMoveName": {
                    "type": "string"
                  },
                  "field": {
                    "$ref": "#/$defs/fieldSnapshot"
                  }
                }
              }
            },
            "required": [
              "id",
              "instanceId",
              "species",
              "factIds",
              "metric",
              "value",
              "eligibility"
            ]
          }
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "version",
        "facts",
        "contributions",
        "ambiguities",
        "limitations"
      ]
    }
  },
  "$defs": {
    "sideSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "name",
        "active",
        "team"
      ],
      "properties": {
        "slot": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "active": {
          "anyOf": [
            { "$ref": "#/$defs/pokemonSnapshot" },
            { "type": "null" }
          ]
        },
        "team": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pokemonSnapshot"
          },
          "maxItems": 12
        }
      }
    },
    "pokemonSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ident",
        "species",
        "displayName",
        "level",
        "conditionText",
        "hpPercent",
        "status",
        "fainted",
        "active",
        "revealed",
        "boosts",
        "knownMoves",
        "item",
        "ability",
        "types",
        "teraType",
        "terastallized"
      ],
      "properties": {
        "ident": {
          "type": [
            "string",
            "null"
          ]
        },
        "species": {
          "type": [
            "string",
            "null"
          ]
        },
        "displayName": {
          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "type": ["integer", "null"]
        },
        "conditionText": {
          "type": [
            "string",
            "null"
          ]
        },
        "hpPercent": {
          "type": [
            "number",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "fainted": {
          "type": "boolean"
        },
        "active": {
          "type": "boolean"
        },
        "revealed": {
          "type": "boolean"
        },
        "boosts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "stats": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "knownMoves": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 12
        },
        "item": {
          "type": [
            "string",
            "null"
          ]
        },
        "itemProof": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hazard", "turn", "factIds"],
          "properties": {
            "hazard": { "type": "string" },
            "turn": { "type": "integer", "minimum": 0 },
            "factIds": { "type": "array", "items": { "type": "string" } }
          }
        },
        "removedItem": {
          "type": ["string", "null"]
        },
        "ability": {
          "type": [
            "string",
            "null"
          ]
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 3
        },
        "teraType": {
          "type": [
            "string",
            "null"
          ]
        },
        "terastallized": {
          "type": "boolean"
        },
        "unburdenActive": {
          "type": "boolean"
        },
        "slowStartActive": {
          "type": "boolean"
        },
        "paradoxBoostedStat": {
          "enum": [
            "atk",
            "def",
            "spa",
            "spd",
            "spe",
            null
          ]
        },
        "instanceId": {
          "type": "string"
        },
        "appearanceId": {
          "type": "string"
        },
        "presumedInstanceId": {
          "type": "string"
        },
        "canonicalSpecies": {
          "type": "string"
        },
        "candidateInstanceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "appearanceMoves": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "identityStatus": {
          "enum": [
            "resolved",
            "provisional",
            "ambiguous"
          ]
        },
        "turnsSinceEntry": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "fieldSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weather",
        "terrain",
        "pseudoWeather",
        "yourSideConditions",
        "opponentSideConditions"
      ],
      "properties": {
        "weather": {
          "type": [
            "string",
            "null"
          ]
        },
        "terrain": {
          "type": [
            "string",
            "null"
          ]
        },
        "pseudoWeather": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 12
        },
        "yourSideConditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 12
        },
        "opponentSideConditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 12
        }
      }
    },
    "legalAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "move",
            "switch",
            "team",
            "special"
          ]
        },
        "label": {
          "type": "string"
        },
        "moveName": {
          "type": [
            "string",
            "null"
          ]
        },
        "moveSlot": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 4
        },
        "targetSlot": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 24
        },
        "terastallize": {
          "type": "boolean"
        },
        "actorSlot": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "moveId": {
          "type": "string"
        },
        "teamSpec": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true
        },
        "choice": {
          "type": "string"
        },
        "legality": {
          "type": "string",
          "enum": [
            "certain",
            "uncertain",
            "disabled"
          ]
        },
        "canUndo": {
          "type": "boolean"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "pp": {
          "type": [
            "integer",
            "null"
          ]
        },
        "disabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "uncertainLegal": {
          "type": "boolean"
        },
        "details": {
          "type": [
            "string",
            "null"
          ]
        },
        "uncertaintyReason": {
          "enum": [
            "maybe_disabled",
            "hidden_trapping_ability"
          ]
        },
        "reviving": {
          "type": "boolean"
        },
        "actorAppearanceId": {
          "type": "string"
        },
        "targetInstanceId": {
          "type": "string"
        }
      }
    }
  }
}
